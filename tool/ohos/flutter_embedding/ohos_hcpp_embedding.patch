+            ? rects.filter((rect: OverlayRect): boolean => rect.viewId !== viewId)
+            : rects);
+        }
+      }
+    }
+    AppStorage.setOrCreate<Map<string, OverlayRect[]>>(OVERLAY_RECT_MAP_KEY, newMap);
+  }
+
+  /** Remove only this FlutterView's independent HCPP input slice. */
+  private removeHcppInputRectsFromStorage(): void {
+    const viewKey = this.flutterView?.getId();
+    if (viewKey == undefined) {
+      return;
+    }
+    const oldMap = AppStorage.get<Map<string, HcppInputRect[]>>(HCPP_INPUT_RECT_MAP_KEY);
+    if (oldMap == undefined || !oldMap.has(viewKey)) {
+      return;
+    }
+    const newMap: Map<string, HcppInputRect[]> = new Map();
+    for (const key of Array.from(oldMap.keys())) {
+      if (key === viewKey) {
+        continue;
+      }
+      const rects = oldMap.get(key);
+      if (rects != undefined) {
+        newMap.set(key, rects);
+      }
+    }
+    AppStorage.setOrCreate<Map<string, HcppInputRect[]>>(HCPP_INPUT_RECT_MAP_KEY, newMap);
+  }
+
+  /** Remove only one platform view's input rect from this FlutterView slice. */
+  private removeHcppInputRectFromStorage(viewId: number): void {
+    const viewKey = this.flutterView?.getId();
+    if (viewKey == undefined) {
+      return;
+    }
+    const oldMap = AppStorage.get<Map<string, HcppInputRect[]>>(HCPP_INPUT_RECT_MAP_KEY);
+    const oldRects = oldMap?.get(viewKey);
+    if (oldRects == undefined) {
+      return;
+    }
+    const newMap: Map<string, HcppInputRect[]> = new Map();
+    if (oldMap != undefined) {
+      for (const key of Array.from(oldMap.keys())) {
+        const rects = oldMap.get(key);
+        if (rects != undefined) {
+          newMap.set(key, key === viewKey
+            ? rects.filter((rect: HcppInputRect): boolean => rect.platformViewId !== viewId)
+            : rects);
+        }
+      }
+    }
+    AppStorage.setOrCreate<Map<string, HcppInputRect[]>>(HCPP_INPUT_RECT_MAP_KEY, newMap);
+  }
 }

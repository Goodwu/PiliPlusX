+      const platformViewId: number = 360;
+      controller.createForPlatformViewLayer(makeCreateRequest(platformViewId));
+
+      controller.onBeginFrameHybrid();
+      controller.onDisplayPlatformViewHybrid(platformViewId, 12, 24, 200, 100, 200, 100);
+      controller.onEndFrameHybrid();
+      let inputMap: Map<string, HcppInputRect[]> =
+        AppStorage.get('hcpp_input_rects_map') as Map<string, HcppInputRect[]>;
+      const first: HcppInputRect = inputMap.get('fake-flutter-view')![0];
+      const firstX: number = first.x;
+      expect(first.platformViewId).assertEqual(platformViewId);
+      expect(first.visible).assertEqual(true);
+      expect(first.width > 0 && first.height > 0).assertEqual(true);
+      expect(hcppInputRectKey(platformViewId)).assertEqual('hcpp-input-360');
+
+      // A coordinate-only update retains the observed object and therefore
+      // the ForEach key/node while a touch sequence is in flight.
+      controller.onBeginFrameHybrid();
+      controller.onDisplayPlatformViewHybrid(platformViewId, 40, 50, 220, 110, 220, 110);
+      controller.onEndFrameHybrid();
+      inputMap = AppStorage.get('hcpp_input_rects_map') as Map<string, HcppInputRect[]>;
+      const second: HcppInputRect = inputMap.get('fake-flutter-view')![0];
+      expect(second === first).assertEqual(true);
+      expect(second.x !== firstX).assertEqual(true);
+
+      // No DISPLAY callback in the next frame means invisible and clears the
+      // independent input slice; overlay storage remains a separate contract.
+      controller.onBeginFrameHybrid();
+      controller.onEndFrameHybrid();
+      inputMap = AppStorage.get('hcpp_input_rects_map') as Map<string, HcppInputRect[]>;
+      expect(inputMap.get('fake-flutter-view')!.length).assertEqual(0);
+
+      controller.dispose(platformViewId);
+      controller.detachFromView();
+      controller.detach();
+    });
